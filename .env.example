# URL du site servie (V1 : a3studio.io — cible : a3studio.fr)
NEXT_PUBLIC_SITE_URL=https://www.a3studio.io

# ──────────────────────────────────────────────────────────────────────────
# Formulaire de contact — envoi d'e-mails (Resend)
# L'API /api/contact n'accuse JAMAIS un succès à un utilisateur réel si l'e-mail
# n'a pas été envoyé. Tant que ces variables ne sont pas renseignées, le
# formulaire renvoie une erreur (et un détail explicite en développement).
# ──────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=s.bertucci@a3studio.fr
# Adresse d'expédition — domaine vérifié chez le prestataire (ex. contact@a3studio.fr)
CONTACT_FROM_EMAIL=

# ──────────────────────────────────────────────────────────────────────────
# Informations légales NON confirmées — source de vérité unique (aucun défaut).
# Laisser vide tant que non confirmé : en développement la mention « non publiable »
# s'affiche ; en production les lignes incomplètes sont masquées et `npm run check:legal`
# échoue. À renseigner avant publication.
# ──────────────────────────────────────────────────────────────────────────
LEGAL_RCS=
LEGAL_APE=
LEGAL_TVA=

# Hébergeur RÉEL du site (≠ fournisseur DNS/domaine). Ex. si déployé chez Vercel : Vercel Inc.
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
# Passer à "true" UNIQUEMENT quand l'hébergeur réel est confirmé.
LEGAL_HOST_CONFIRMED=false
